# ---------------------------------------------------------------------------
# OpenToAll — environment variables
# Copy this file to .env and fill in your own values. NEVER commit .env.
# ---------------------------------------------------------------------------

# Django
DEBUG=True
SECRET_KEY=change-me-generate-with-django
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://your-domain.com

# Database
# Local: SQLite (default). Do NOT set DATABASE_URL to localhost unless Postgres
# is actually running — that is the #1 reason the site fails to open.
# Prod (Render/Neon): set DATABASE_URL to the Neon connection string.
USE_POSTGRES=0
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# DB_SSL_REQUIRE=True
DB_NAME=opentoall
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis / Celery (docker-compose). Cache Redis is auto-enabled when DEBUG=False.
REDIS_URL=redis://127.0.0.1:6379/0
# USE_REDIS_CACHE=1
# CACHE_URL=redis://127.0.0.1:6379/1
# FLOWER_BASIC_AUTH=admin:changeme

# Optional error tracking (Django + Celery)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0
# LOG_FORMAT=json
# LOG_LEVEL=INFO

# GitHub OAuth application (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub Personal Access Token for API ingestion.
# Create one at https://github.com/settings/tokens (no scope needed for public data).
# NOTE: a PAT looks like "ghp_xxxxxxxx..." — NOT an SSH key fingerprint.
GITHUB_PAT=

# Cron endpoint secret (Render free + cron-job.org)
# python -c "import secrets; print(secrets.token_urlsafe(32))"
FETCH_ISSUES_TOKEN=

# Optional: auto-create admin on container start (Render)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=change-me
# ADMIN_EMAIL=you@example.com

# Public repository URL shown in the UI ("Contribuer")
GITHUB_REPO_URL=https://github.com/Ymax27/opentoall
