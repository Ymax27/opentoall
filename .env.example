# ---------------------------------------------------------------------------
# OpenToAll — environment variables
# Copy this file to .env and fill in your own values. NEVER commit .env.
# ---------------------------------------------------------------------------

# Django
DEBUG=True
SECRET_KEY=change-me-generate-with-django
ALLOWED_HOSTS=localhost,127.0.0.1
# CSRF_TRUSTED_ORIGINS=https://your-domain.com

# Database
# Local dev uses SQLite automatically. Set USE_POSTGRES=1 to use PostgreSQL.
USE_POSTGRES=0
DB_NAME=opentoall
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/0

# GitHub OAuth application (https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# GitHub Personal Access Token for API ingestion.
# Create one at https://github.com/settings/tokens (no scope needed for public data).
# NOTE: a PAT looks like "ghp_xxxxxxxx..." — NOT an SSH key fingerprint.
GITHUB_PAT=

# Public repository URL shown in the UI ("Contribuer")
GITHUB_REPO_URL=https://github.com/Ymax27/opentoall
